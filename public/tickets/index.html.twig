{% extends "layouts/main.html.twig" %}
{% block title %}Tickets de Soporte{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="fw-bold mb-1"><i class="bi bi-ticket-perforated me-2 text-primary"></i>Tickets</h2>
		<p class="text-muted mb-0 small">Gestión general, estados y seguimiento de tickets de soporte</p>
	</div>
	<a href="{{ base_url }}/ticket/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Nuevo Ticket</a>
</div>

<!-- Tarjetas de Conteo por Status -->
<div class="row g-3 mb-4">
	{% for sc in status_counts %}
		{% set border_color = '#6c757d' %}
		{% set text_color = 'text-secondary' %}
		{% set icon_class = 'bi-check-circle' %}

		{% if sc.id == 1 %}
			{% set border_color = '#f9b115' %}
			{% set text_color = 'text-warning' %}
			{% set icon_class = 'bi-clock-history' %}
		{% elseif sc.id == 2 %}
			{% set border_color = '#321fdb' %}
			{% set text_color = 'text-primary' %}
			{% set icon_class = 'bi-gear-wide-connected' %}
		{% elseif sc.id == 3 %}
			{% set border_color = '#2eb85c' %}
			{% set text_color = 'text-success' %}
			{% set icon_class = 'bi-check2-circle' %}
		{% elseif sc.id == 4 %}
			{% set border_color = '#e55353' %}
			{% set text_color = 'text-danger' %}
			{% set icon_class = 'bi-x-circle' %}
		{% endif %}

		{% set is_active_status = filters.status_id is defined and filters.status_id == sc.id %}

		<div class="col-6 col-lg-3">
			<a href="{{ base_url }}/tickets?status_id={{ sc.id }}" class="text-decoration-none text-dark">
				<div class="card shadow-sm border-0 h-100 card-hover {{ is_active_status ? 'shadow ring-2 ring-primary' : '' }}" style="border-left: 4px solid {{ border_color }} !important; {{ is_active_status ? 'background-color: #f8f9ff;' : '' }}">
					<div class="card-body p-3 d-flex align-items-center justify-content-between">
						<div>
							<div class="fs-4 fw-bold {{ text_color }}">{{ sc.total }}</div>
							<div class="text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;">{{ sc.name }}</div>
						</div>
						<div class="{{ text_color }} opacity-50">
							<i class="bi {{ icon_class }} fs-2"></i>
						</div>
					</div>
				</div>
			</a>
		</div>
	{% endfor %}
</div>

<!-- Filtros de Búsqueda -->
<div class="card shadow-sm border-0 mb-4">
	<div class="card-body">
		<form method="get" action="{{ base_url }}/tickets" class="row g-2 align-items-center">
			<div class="col-md-3">
				<input type="text" name="q" value="{{ filters.q|default('') }}" class="form-control" placeholder="Buscar por palabra clave...">
			</div>
			<div class="col-md-2">
				<select name="project_id" class="form-select">
					<option value="">-- Proyecto --</option>
					{% for p in projects %}
						<option value="{{ p.id }}" {% if filters.project_id == p.id %}selected{% endif %}>{{ p.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="col-md-2">
				<select name="category_id" class="form-select">
					<option value="">-- Categoría --</option>
					{% for c in categories %}
						<option value="{{ c.id }}" {% if filters.category_id == c.id %}selected{% endif %}>{{ c.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="col-md-2">
				<select name="status_id" class="form-select">
					<option value="">-- Estado --</option>
					{% for s in statuses %}
						<option value="{{ s.id }}" {% if filters.status_id == s.id %}selected{% endif %}>{{ s.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="col-md-2">
				<input type="date" name="date_at" value="{{ filters.date_at|default('') }}" class="form-control" title="Filtrar por fecha">
			</div>
			<div class="col-md-1 d-flex gap-1">
				<button type="submit" class="btn btn-primary w-100" title="Buscar"><i class="bi bi-search"></i></button>
				{% if filters.q or filters.project_id or filters.category_id or filters.status_id or filters.date_at %}
					<a href="{{ base_url }}/tickets" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-circle"></i></a>
				{% endif %}
			</div>
		</form>
	</div>
</div>

<!-- Listado de Tickets -->
<div class="card shadow-sm border-0">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-list-task me-2"></i>Listado de Tickets</h5>
		{% if filters.status_id %}
			{% set filtered_status_name = '' %}
			{% for s in statuses %}
				{% if s.id == filters.status_id %}{% set filtered_status_name = s.name %}{% endif %}
			{% endfor %}
			<span class="badge bg-secondary">Filtrado por: {{ filtered_status_name }}</span>
		{% endif %}
	</div>
	<div class="card-body">
		{% if tickets|length > 0 %}
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th>Asunto</th>
							<th>Proyecto</th>
							<th>Tipo</th>
							<th>Prioridad</th>
							<th>Estado</th>
							<th>Fecha</th>
							<th class="text-end" style="width: 140px;">Acciones</th>
						</tr>
					</thead>
					<tbody>
						{% for t in tickets %}
							{% set prio_name = t.priority ? t.priority.name : 'Normal' %}
							{% set prio_badge = 'secondary' %}
							{% if t.priority_id == 1 %}{% set prio_badge = 'danger' %}
							{% elseif t.priority_id == 2 %}{% set prio_badge = 'warning text-dark' %}
							{% elseif t.priority_id == 3 %}{% set prio_badge = 'info text-dark' %}
							{% endif %}

							{% set status_name = t.status ? t.status.name : 'Pendiente' %}
							{% set status_badge = 'warning text-dark' %}
							{% if t.status_id == 2 %}{% set status_badge = 'primary' %}
							{% elseif t.status_id == 3 %}{% set status_badge = 'success' %}
							{% elseif t.status_id == 4 %}{% set status_badge = 'dark' %}
							{% endif %}

							<tr>
								<td>
									<div class="fw-bold">{{ t.title }}</div>
									{% if t.category %}
										<small class="text-muted"><i class="bi bi-tag"></i> {{ t.category.name }}</small>
									{% endif %}
								</td>
								<td>{{ t.project ? t.project.name : '<span class="text-muted">Sin proyecto</span>'|raw }}</td>
								<td><span class="badge bg-light text-dark border">{{ t.kind ? t.kind.name : 'Ticket' }}</span></td>
								<td><span class="badge bg-{{ prio_badge }}">{{ prio_name }}</span></td>
								<td><span class="badge bg-{{ status_badge }}">{{ status_name }}</span></td>
								<td><small class="text-muted">{{ t.created_at }}</small></td>
								<td class="text-end">
									<a href="{{ base_url }}/ticket/{{ t.id }}/edit" class="btn btn-warning btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
									<form method="post" action="{{ base_url }}/ticket/{{ t.id }}/delete" class="d-inline form-delete" onsubmit="return confirm('¿Estás seguro de eliminar este ticket?');">
										{{ csrf_field() }}
										<button type="submit" class="btn btn-danger btn-sm text-white" title="Eliminar"><i class="bi bi-trash"></i></button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<div class="alert alert-warning mb-0" role="alert">
				<i class="bi bi-exclamation-triangle me-2"></i> No se encontraron tickets registrados con los filtros aplicados.
			</div>
		{% endif %}
	</div>
</div>
{% endblock %}
