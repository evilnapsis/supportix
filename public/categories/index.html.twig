{% extends "layouts/main.html.twig" %}
{% block title %}Categorías{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
	<h2 class="fw-bold mb-0"><i class="bi bi-tags me-2"></i>Categorías</h2>
	<a href="{{ base_url }}/category/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Nueva Categoría</a>
</div>

<div class="card shadow-sm border-0">
	<div class="card-header bg-white py-3">
		<h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-list-ul me-2"></i>Listado de Categorías</h5>
	</div>
	<div class="card-body">
		{% if categories|length > 0 %}
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th style="width: 80px;">ID</th>
							<th>Nombre de la Categoría</th>
							<th class="text-end" style="width: 140px;">Acciones</th>
						</tr>
					</thead>
					<tbody>
						{% for category in categories %}
							<tr>
								<td><span class="badge bg-light text-dark border">#{{ category.id }}</span></td>
								<td class="fw-semibold">{{ category.name }}</td>
								<td class="text-end">
									<a href="{{ base_url }}/category/{{ category.id }}/edit" class="btn btn-warning btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
									<form action="{{ base_url }}/category/{{ category.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar esta categoría?');">
										{{ csrf_field() }}
										<button type="submit" class="btn btn-danger btn-sm text-white" title="Eliminar"><i class="bi bi-trash"></i></button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<div class="alert alert-warning mb-0" role="alert">
				<i class="bi bi-exclamation-triangle me-2"></i> No hay categorías registradas.
			</div>
		{% endif %}
	</div>
</div>
{% endblock %}
