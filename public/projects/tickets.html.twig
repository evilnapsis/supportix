{% extends "layouts/main.html.twig" %}
{% block title %}Tickets del Proyecto: {{ project.name }}{% endblock %}
{% block content %}
<!-- Cabecera del Proyecto -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
	<div>
		<div class="d-flex align-items-center gap-2 mb-1">
			<a href="{{ base_url }}/projects" class="btn btn-outline-secondary btn-sm" title="Volver al listado de proyectos">
				<i class="bi bi-arrow-left"></i>
			</a>
			<h2 class="fw-bold mb-0">
				<i class="bi bi-folder2-open text-primary me-2"></i>{{ project.name }}
			</h2>
			<span class="badge bg-light text-muted border">ID #{{ project.id }}</span>
		</div>
		<p class="text-muted small mb-0 ms-4 ps-2">
			{{ project.description ? project.description : 'Gestión y seguimiento de tickets pertenecientes a este proyecto' }}
		</p>
	</div>
	<div class="d-flex gap-2">
		<a href="{{ base_url }}/ticket/new?project_id={{ project.id }}" class="btn btn-primary">
			<i class="bi bi-plus-circle me-1"></i> Nuevo Ticket en este Proyecto
		</a>
	</div>
</div>

<!-- Tarjetas de Conteo de Status de este Proyecto -->
<div class="row g-3 mb-4">
	{% for sc in status_counts %}
		{% set border_color = '#6c757d' %}
		{% set text_color = 'text-secondary' %}
		{% set icon_class = 'bi-check-circle' %}

		{% if sc.id == 1 %}
			{% set border_color = '#f9b115' %}
			{% set text_color = 'text-warning' %}
			{% set icon_class = 'bi-clock-history' %}
		{% elseif sc.id == 2 %}
			{% set border_color = '#321fdb' %}
			{% set text_color = 'text-primary' %}
			{% set icon_class = 'bi-gear-wide-connected' %}
		{% elseif sc.id == 3 %}
			{% set border_color = '#2eb85c' %}
			{% set text_color = 'text-success' %}
			{% set icon_class = 'bi-check2-circle' %}
		{% elseif sc.id == 4 %}
			{% set border_color = '#e55353' %}
			{% set text_color = 'text-danger' %}
			{% set icon_class = 'bi-x-circle' %}
		{% endif %}

		{% set is_active_status = filters.status_id is defined and filters.status_id == sc.id %}

		<div class="col-6 col-lg-3">
			<a href="{{ base_url }}/project/{{ project.id }}/tickets?status_id={{ sc.id }}" class="text-decoration-none text-dark">
				<div class="card shadow-sm border-0 h-100 card-hover {{ is_active_status ? 'shadow ring-2 ring-primary' : '' }}" style="border-left: 4px solid {{ border_color }} !important; {{ is_active_status ? 'background-color: #f8f9ff;' : '' }}">
					<div class="card-body p-3 d-flex align-items-center justify-content-between">
						<div>
							<div class="fs-4 fw-bold {{ text_color }}">{{ sc.total }}</div>
							<div class="text-uppercase fw-bold text-muted small" style="font-size: 0.75rem;">{{ sc.name }}</div>
						</div>
						<div class="{{ text_color }} opacity-50">
							<i class="bi {{ icon_class }} fs-2"></i>
						</div>
					</div>
				</div>
			</a>
		</div>
	{% endfor %}
</div>

<!-- Filtros de Categoría y Status -->
<div class="card shadow-sm border-0 mb-4">
	<div class="card-body">
		<form method="get" action="{{ base_url }}/project/{{ project.id }}/tickets" class="row g-2 align-items-center">
			<div class="col-md-4">
				<input type="text" name="q" value="{{ filters.q|default('') }}" class="form-control" placeholder="Buscar por palabra clave...">
			</div>
			<div class="col-md-3">
				<select name="category_id" class="form-select">
					<option value="">-- Todas las Categorías --</option>
					{% for c in categories %}
						<option value="{{ c.id }}" {% if filters.category_id == c.id %}selected{% endif %}>{{ c.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="col-md-3">
				<select name="status_id" class="form-select">
					<option value="">-- Todos los Estados --</option>
					{% for s in statuses %}
						<option value="{{ s.id }}" {% if filters.status_id == s.id %}selected{% endif %}>{{ s.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="col-md-2 d-flex gap-1">
				<button type="submit" class="btn btn-primary w-100" title="Filtrar"><i class="bi bi-funnel me-1"></i> Filtrar</button>
				{% if filters.q or filters.category_id or filters.status_id %}
					<a href="{{ base_url }}/project/{{ project.id }}/tickets" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-x-circle"></i></a>
				{% endif %}
			</div>
		</form>
	</div>
</div>

<!-- Tabla de Tickets del Proyecto -->
<div class="card shadow-sm border-0">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h5 class="card-title mb-0 fw-bold text-primary">
			<i class="bi bi-list-task me-2"></i>Tickets del Proyecto ({{ tickets|length }})
		</h5>
		{% if filters.status_id or filters.category_id %}
			<span class="badge bg-secondary">Resultados filtrados</span>
		{% endif %}
	</div>
	<div class="card-body">
		{% if tickets|length > 0 %}
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th>Asunto</th>
							<th>Categoría</th>
							<th>Tipo</th>
							<th>Prioridad</th>
							<th>Estado</th>
							<th>Fecha</th>
							<th class="text-end" style="width: 140px;">Acciones</th>
						</tr>
					</thead>
					<tbody>
						{% for t in tickets %}
							{% set prio_name = t.priority ? t.priority.name : 'Normal' %}
							{% set prio_badge = 'secondary' %}
							{% if t.priority_id == 1 %}{% set prio_badge = 'danger' %}
							{% elseif t.priority_id == 2 %}{% set prio_badge = 'warning text-dark' %}
							{% elseif t.priority_id == 3 %}{% set prio_badge = 'info text-dark' %}
							{% endif %}

							{% set status_name = t.status ? t.status.name : 'Pendiente' %}
							{% set status_badge = 'warning text-dark' %}
							{% if t.status_id == 2 %}{% set status_badge = 'primary' %}
							{% elseif t.status_id == 3 %}{% set status_badge = 'success' %}
							{% elseif t.status_id == 4 %}{% set status_badge = 'dark' %}
							{% endif %}

							<tr>
								<td>
									<div class="fw-bold">{{ t.title }}</div>
									<small class="text-muted text-truncate d-inline-block" style="max-width: 320px;">{{ t.description }}</small>
								</td>
								<td>{{ t.category ? t.category.name : '<span class="text-muted">-</span>'|raw }}</td>
								<td><span class="badge bg-light text-dark border">{{ t.kind ? t.kind.name : 'Ticket' }}</span></td>
								<td><span class="badge bg-{{ prio_badge }}">{{ prio_name }}</span></td>
								<td><span class="badge bg-{{ status_badge }}">{{ status_name }}</span></td>
								<td><small class="text-muted">{{ t.created_at }}</small></td>
								<td class="text-end">
									<a href="{{ base_url }}/ticket/{{ t.id }}/edit" class="btn btn-warning btn-sm" title="Editar"><i class="bi bi-pencil"></i></a>
									<form method="post" action="{{ base_url }}/ticket/{{ t.id }}/delete" class="d-inline form-delete" onsubmit="return confirm('¿Estás seguro de eliminar este ticket?');">
										{{ csrf_field() }}
										<button type="submit" class="btn btn-danger btn-sm text-white" title="Eliminar"><i class="bi bi-trash"></i></button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<div class="alert alert-warning mb-0" role="alert">
				<i class="bi bi-exclamation-triangle me-2"></i> No hay tickets registrados en este proyecto con los filtros aplicados.
			</div>
		{% endif %}
	</div>
</div>
{% endblock %}
