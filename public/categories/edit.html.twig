{% extends "layouts/main.html.twig" %}
{% block title %}Editar Categoría{% endblock %}
{% block content %}
<div class="row justify-content-center">
	<div class="col-lg-6">
		<div class="card shadow-sm border-0 mb-4">
			<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
				<h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Editar Categoría</h5>
				<a href="{{ base_url }}/categories" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Volver</a>
			</div>
			<div class="card-body p-4">
				<form method="post" action="{{ base_url }}/category/{{ category.id }}/update">
					{{ csrf_field() }}

					<div class="mb-3">
						<label class="form-label fw-semibold">Nombre de la Categoría <span class="text-danger">*</span></label>
						<input type="text" name="name" value="{{ category.name }}" required class="form-control" placeholder="Nombre de la categoría">
					</div>

					<div class="d-grid gap-2 mt-4">
						<button type="submit" class="btn btn-primary btn-lg fw-bold"><i class="bi bi-save me-1"></i> Actualizar Categoría</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
