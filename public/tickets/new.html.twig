{% extends "layouts/main.html.twig" %}
{% block title %}Nuevo Ticket{% endblock %}
{% block content %}
<div class="row justify-content-center">
	<div class="col-lg-8">
		<div class="card shadow-sm border-0 mb-4">
			<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
				<h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo Ticket</h5>
				<a href="{{ base_url }}/tickets" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Volver</a>
			</div>
			<div class="card-body p-4">
				<form method="post" action="{{ base_url }}/ticket/create">
					{{ csrf_field() }}

					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label fw-semibold">Tipo de Ticket <span class="text-danger">*</span></label>
							<select name="kind_id" class="form-select" required>
								{% for k in kinds %}
									<option value="{{ k.id }}">{{ k.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-md-6">
							<label class="form-label fw-semibold">Proyecto</label>
							<select name="project_id" class="form-select select2">
								<option value="">-- Seleccionar Proyecto --</option>
								{% for p in projects %}
									<option value="{{ p.id }}" {% if selected_project_id is defined and selected_project_id == p.id %}selected{% endif %}>{{ p.name }}</option>
								{% endfor %}
							</select>
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label fw-semibold">Título / Asunto <span class="text-danger">*</span></label>
						<input type="text" name="title" required class="form-control" placeholder="Ej: Error al generar comprobante...">
					</div>

					<div class="mb-3">
						<label class="form-label fw-semibold">Descripción del Ticket <span class="text-danger">*</span></label>
						<textarea class="form-control" name="description" rows="5" required placeholder="Describe detalladamente el problema o requerimiento..."></textarea>
					</div>

					<div class="row mb-3">
						<div class="col-md-4">
							<label class="form-label fw-semibold">Categoría</label>
							<select name="category_id" class="form-select select2">
								<option value="">-- Seleccionar Categoría --</option>
								{% for c in categories %}
									<option value="{{ c.id }}">{{ c.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-md-4">
							<label class="form-label fw-semibold">Prioridad <span class="text-danger">*</span></label>
							<select name="priority_id" class="form-select" required>
								{% for pr in priorities %}
									<option value="{{ pr.id }}" {% if pr.id == 2 %}selected{% endif %}>{{ pr.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-md-4">
							<label class="form-label fw-semibold">Estado <span class="text-danger">*</span></label>
							<select name="status_id" class="form-select" required>
								{% for s in statuses %}
									<option value="{{ s.id }}" {% if s.id == 1 %}selected{% endif %}>{{ s.name }}</option>
								{% endfor %}
							</select>
						</div>
					</div>

					<div class="d-grid gap-2 mt-4">
						<button type="submit" class="btn btn-primary btn-lg fw-bold"><i class="bi bi-check-circle me-1"></i> Registrar Ticket</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
