{% extends "layouts/main.html.twig" %}
{% block title %}Editar Ticket #{{ ticket.id }}{% endblock %}
{% block content %}
<div class="row justify-content-center">
	<div class="col-lg-8">
		<div class="card shadow-sm border-0 mb-4">
			<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
				<h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Modificar Ticket #{{ ticket.id }}</h5>
				<a href="{{ base_url }}/tickets" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Volver</a>
			</div>
			<div class="card-body p-4">
				<form method="post" action="{{ base_url }}/ticket/{{ ticket.id }}/update">
					{{ csrf_field() }}

					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label fw-semibold">Tipo de Ticket <span class="text-danger">*</span></label>
							<select name="kind_id" class="form-select" required>
								{% for k in kinds %}
									<option value="{{ k.id }}" {% if ticket.kind_id == k.id %}selected{% endif %}>{{ k.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-md-6">
							<label class="form-label fw-semibold">Proyecto</label>
							<select name="project_id" class="form-select select2">
								<option value="">-- Seleccionar Proyecto --</option>
								{% for p in projects %}
									<option value="{{ p.id }}" {% if ticket.project_id == p.id %}selected{% endif %}>{{ p.name }}</option>
								{% endfor %}
							</select>
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label fw-semibold">Título / Asunto <span class="text-danger">*</span></label>
						<input type="text" name="title" value="{{ ticket.title }}" required class="form-control" placeholder="Título o asunto">
					</div>

					<div class="mb-3">
						<label class="form-label fw-semibold">Descripción <span class="text-danger">*</span></label>
						<textarea class="form-control" name="description" rows="5" required placeholder="Descripción del ticket">{{ ticket.description }}</textarea>
					</div>

					<div class="row mb-3">
						<div class="col-md-4">
							<label class="form-label fw-semibold">Categoría</label>
							<select name="category_id" class="form-select select2">
								<option value="">-- Seleccionar Categoría --</option>
								{% for c in categories %}
									<option value="{{ c.id }}" {% if ticket.category_id == c.id %}selected{% endif %}>{{ c.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-md-4">
							<label class="form-label fw-semibold">Prioridad <span class="text-danger">*</span></label>
							<select name="priority_id" class="form-select" required>
								{% for pr in priorities %}
									<option value="{{ pr.id }}" {% if ticket.priority_id == pr.id %}selected{% endif %}>{{ pr.name }}</option>
								{% endfor %}
							</select>
						</div>
						<div class="col-md-4">
							<label class="form-label fw-semibold">Estado <span class="text-danger">*</span></label>
							<select name="status_id" class="form-select" required>
								{% for s in statuses %}
									<option value="{{ s.id }}" {% if ticket.status_id == s.id %}selected{% endif %}>{{ s.name }}</option>
								{% endfor %}
							</select>
						</div>
					</div>

					<div class="d-grid gap-2 mt-4">
						<button type="submit" class="btn btn-primary btn-lg fw-bold"><i class="bi bi-save me-1"></i> Guardar Cambios</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{% endblock %}
